<Window x:Class="video_media_player.SaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn thư mục lưu video" 
        Height="300" 
        Width="500" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="ToolWindow">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Chọn thư mục để lưu video xuất" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Video sẽ được lưu vào thư mục bạn chọn" 
                       FontSize="12" 
                       Foreground="Gray" 
                       HorizontalAlignment="Center" 
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Content -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Current Path Display -->
            <TextBlock Text="Thư mục hiện tại:" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5"/>
            <Border Background="#f5f5f5" 
                    BorderBrush="#ddd" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10">
                <TextBlock x:Name="CurrentPathTextBlock" 
                           Text="Chưa chọn thư mục" 
                           Foreground="#666" 
                           TextWrapping="Wrap"/>
            </Border>
            
            <!-- Quick Access Folders -->
            <TextBlock Text="Thư mục nhanh:" 
                       FontWeight="SemiBold" 
                       Margin="0,20,0,10"/>
            <WrapPanel>
                <Button x:Name="DesktopButton" 
                        Content="Desktop" 
                        Width="100" 
                        Height="30" 
                        Margin="0,0,10,10" 
                        Click="QuickFolderButton_Click"
                        Tag="Desktop"/>
                <Button x:Name="DownloadsButton" 
                        Content="Downloads" 
                        Width="100" 
                        Height="30" 
                        Margin="0,0,10,10" 
                        Click="QuickFolderButton_Click"
                        Tag="Downloads"/>
                <Button x:Name="DocumentsButton" 
                        Content="Documents" 
                        Width="100" 
                        Height="30" 
                        Margin="0,0,10,10" 
                        Click="QuickFolderButton_Click"
                        Tag="Documents"/>
                <Button x:Name="PicturesButton" 
                        Content="Pictures" 
                        Width="100" 
                        Height="30" 
                        Margin="0,0,10,10" 
                        Click="QuickFolderButton_Click"
                        Tag="Pictures"/>
            </WrapPanel>
        </StackPanel>
        
        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button x:Name="BrowseButton" 
                    Content="Browse..." 
                    Width="80" 
                    Height="30" 
                    Margin="0,0,10,0" 
                    Click="BrowseButton_Click"/>
            <Button x:Name="OKButton" 
                    Content="OK" 
                    Width="60" 
                    Height="30" 
                    Background="#4CAF50" 
                    Foreground="White" 
                    FontWeight="Bold"
                    Click="OKButton_Click"
                    IsEnabled="False"/>
            <Button x:Name="CancelButton" 
                    Content="Cancel" 
                    Width="60" 
                    Height="30" 
                    Background="#f44336" 
                    Foreground="White" 
                    FontWeight="Bold"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 